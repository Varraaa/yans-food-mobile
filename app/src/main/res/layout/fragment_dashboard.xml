<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <!-- JUDUL SEKSI RINGKASAN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="RINGKASAN HARI INI"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs" />

            <!-- BARIS KPI 1: OMSET & TRANSAKSI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- KARTU OMSET -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_4"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardElevation="@dimen/elevation_card"
                    app:strokeColor="@color/border_soft"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_12">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="🍔 Omset Kasir POS"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_xs" />

                        <TextView
                            android:id="@+id/tvKpiSales"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:fontFamily="sans-serif-black"
                            android:text="Rp 450.000"
                            android:textColor="@color/brand_primary"
                            android:textSize="@dimen/text_lg" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KARTU STRUK TRANSAKSI -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardElevation="@dimen/elevation_card"
                    app:strokeColor="@color/border_soft"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_12">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="🧾 Transaksi Kasir"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_xs" />

                        <TextView
                            android:id="@+id/tvKpiTransactions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:fontFamily="sans-serif-black"
                            android:text="18 Struk Selesai"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_base" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- BARIS KPI 2: PENGELUARAN & LABA BERSIH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- KARTU PENGELUARAN -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_4"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardElevation="@dimen/elevation_card"
                    app:strokeColor="@color/border_soft"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_12">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="💸 Biaya Dapur"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_xs" />

                        <TextView
                            android:id="@+id/tvKpiExpenses"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:fontFamily="sans-serif-bold"
                            android:text="Rp 120.000"
                            android:textColor="@color/status_danger"
                            android:textSize="@dimen/text_base" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KARTU LABA BERSIH -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardElevation="@dimen/elevation_card"
                    app:strokeColor="@color/border_soft"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_12">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="💰 Laba Bersih Hari Ini"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_xs" />

                        <TextView
                            android:id="@+id/tvKpiProfit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:fontFamily="sans-serif-bold"
                            android:text="Rp 330.000"
                            android:textColor="@color/status_success"
                            android:textSize="@dimen/text_base" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- PERINGATAN STOK MENIPIS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStockAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                app:cardBackgroundColor="@color/status_warning_bg"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="@dimen/elevation_flat"
                app:strokeColor="@color/status_warning"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_12">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="Peringatan Stok Dapur Menipis"
                            android:textColor="@color/status_warning"
                            android:textSize="@dimen/text_sm" />

                        <TextView
                            android:id="@+id/tvStockAlertMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="Dimsum Ayam Jamur tersisa 4 porsi (Segera restock)."
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_xs" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- FEED TRANSAKSI KASIR TERAKHIR -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:fontFamily="sans-serif-bold"
                android:text="FEED TRANSAKSI KASIR TERAKHIR"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs" />

            <!-- LIST TRANSAKSI RECYCLERVIEW -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:layoutAnimation="@anim/layout_animation_staggered"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_transaction" />

            <!-- EMPTY STATE TRANSAKSI -->
            <TextView
                android:id="@+id/tvEmptyTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/space_24"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="Belum ada transaksi kasir tercatat hari ini."
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_sm"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
