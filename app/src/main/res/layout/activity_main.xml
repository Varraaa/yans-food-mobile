<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    tools:context=".ui.main.MainActivity">

    <!-- TOP HEADER BAR (Sesuai Persis dengan Screenshot 1) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:elevation="1dp"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingVertical="@dimen/space_12"
        app:layout_constraintTop_toTopOf="parent">

        <!-- SISI KIRI: LOGO KECIL & NAMA YAN'S FOOD + SUBTITLE -->
        <LinearLayout
            android:id="@+id/layoutBrandHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Logo Card Kecil Rounded -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardBackgroundColor="#FFF8EE"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="#F5E6D3"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_yans_food_logo" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Teks Brand & Halaman -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_10"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTopBrandName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Yan's Food"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvTopSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif"
                    android:text="Beranda"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- SISI KANAN: STATUS "● BUKA" & AVATAR LINGKARAN PUTUS-PUTUS -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Pill Badge Status "● Buka" -->
            <LinearLayout
                android:id="@+id/layoutStatusBuka"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_buka"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/dot_green" />

                <TextView
                    android:id="@+id/tvStatusToko"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Buka"
                    android:textColor="#059669"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Avatar Lingkaran dengan Garis Putus-Putus Biru -->
            <FrameLayout
                android:id="@+id/layoutAvatarOwner"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/space_10"
                android:background="@drawable/bg_avatar_dashed_ring"
                android:padding="3dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="100dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/ivTopAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Foto Profil Owner"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_owner_avatar" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Garis Pemisah Halus di Bawah Top Bar -->
    <View
        android:id="@+id/topBarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_soft"
        app:layout_constraintTop_toBottomOf="@id/topHeaderBar" />

    <!-- Kontainer Halaman Fragment Utama -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarDivider" />

    <!-- Garis Pemisah Halus di Atas Bottom Navigation -->
    <View
        android:id="@+id/bottomNavDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_soft"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation" />

    <!-- BOTTOM NAVBAR (Sesuai Persis dengan Screenshot 2) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/bg_card"
        app:elevation="@dimen/elevation_card"
        app:itemActiveIndicatorStyle="@style/CustomBottomNavActiveIndicator"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>