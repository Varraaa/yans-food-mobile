<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutExpenseRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingTop="@dimen/space_16"
            android:paddingBottom="@dimen/space_8">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="PENGELUARAN DAPUR"
                android:textColor="@color/brand_primary"
                android:textSize="@dimen/text_lg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Catat belanja bahan baku dan foto nota langsung dari pasar"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <!-- SWIPE REFRESH LIST -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshExpenses"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvExpenses"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:layoutAnimation="@anim/layout_animation_staggered"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingBottom="84dp"
                    tools:listitem="@layout/item_expense" />

                <TextView
                    android:id="@+id/tvEmptyExpenses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif"
                    android:text="Belum ada catatan pengeluaran belanja dapur."
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_sm"
                    android:visibility="gone" />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <!-- FLOATING ACTION BUTTON (+) TAMBAH BIAYA -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddExpense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_16"
        android:backgroundTint="@color/brand_primary"
        android:contentDescription="Catat Pengeluaran"
        android:fontFamily="sans-serif-bold"
        android:text="Catat Biaya"
        android:textColor="@color/text_on_primary"
        app:elevation="@dimen/elevation_floating"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@color/text_on_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
