<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <!-- HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="LAPORAN &amp; AKUN OWNER"
            android:textColor="@color/brand_primary"
            android:textSize="@dimen/text_lg" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Status sinkronisasi server dan profil akun gerai"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_xs" />

        <!-- KARTU PROFIL OWNER -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="@dimen/elevation_card"
            app:strokeColor="@color/border_soft"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_16">

                <!-- AVATAR LOGO -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:cardBackgroundColor="@color/brand_primary_light"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardElevation="@dimen/elevation_flat"
                    app:strokeColor="@color/border_soft"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="Avatar"
                        android:src="@drawable/ic_yans_food_logo" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_base"
                        tools:text="Owner Yan's Food" />

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_xs"
                        tools:text="admin@yansfood.id" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:background="@drawable/bg_badge_success"
                        android:fontFamily="sans-serif-bold"
                        android:paddingHorizontal="@dimen/space_8"
                        android:paddingVertical="@dimen/space_2"
                        android:text="Administrator &amp; Pemilik"
                        android:textColor="@color/status_success"
                        android:textSize="@dimen/text_xs" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- KARTU STATUS KONEKSI SERVER -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="@dimen/elevation_card"
            app:strokeColor="@color/border_soft"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Status Sinkronisasi Sistem"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_sm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:fontFamily="sans-serif"
                    android:text="• Backend Server: https://yansfoods.my.id (Biznet GIO)\n• Sinkronisasi POS Kasir: Terhubung &amp; Real-time\n• Database: MySQL 8.x (yans_food terpusat)\n• Versi Aplikasi: 1.0.0 (Native Kotlin Companion)"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_xs" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TOMBOL LOGOUT KELUAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/space_32"
            android:fontFamily="sans-serif-bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/logout"
            android:textColor="@color/status_danger"
            app:cornerRadius="@dimen/radius_button"
            app:strokeColor="@color/status_danger"
            app:strokeWidth="1dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/space_24"
            android:fontFamily="sans-serif"
            android:text="Yan's Food Mobile Admin • Bebas AI Slop"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_xs" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
