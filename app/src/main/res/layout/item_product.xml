<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/space_4"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="@dimen/elevation_card"
    app:strokeColor="@color/border_soft"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_12">

        <!-- THUMBNAIL FOTO PRODUK 76DP -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="76dp"
            android:layout_height="76dp"
            app:cardCornerRadius="@dimen/radius_thumbnail"
            app:cardElevation="@dimen/elevation_flat"
            app:strokeColor="@color/border_soft"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivProductImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Foto Produk"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_food" />
        </com.google.android.material.card.MaterialCardView>

        <!-- INFORMASI PRODUK -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_base"
                tools:text="Dimsum Ayam Original" />

            <TextView
                android:id="@+id/tvProductCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs"
                tools:text="Kategori: Dimsum" />

            <TextView
                android:id="@+id/tvProductPriceAndStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/brand_primary"
                android:textSize="@dimen/text_sm"
                tools:text="Rp 15.000 • 25 porsi" />

            <!-- BADGE STATUS STOK -->
            <TextView
                android:id="@+id/tvStockBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:background="@drawable/bg_badge_success"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="@dimen/space_8"
                android:paddingVertical="@dimen/space_2"
                android:text="Tersedia"
                android:textColor="@color/status_success"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <!-- MATERIAL SWITCH STATUS STOK -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:checked="true"
            app:thumbTint="@color/white"
            app:trackTint="@color/brand_primary" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
