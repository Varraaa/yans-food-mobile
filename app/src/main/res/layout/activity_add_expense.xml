<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutAddExpenseRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <!-- TOOLBAR HEADER DENGAN TOMBOL KEMBALI -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarAddExpense"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_card"
        android:elevation="@dimen/elevation_card"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/brand_primary"
        app:title="Catat Belanja Dapur"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
        app:titleTextColor="@color/text_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarAddExpense">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <!-- INPUT NAMA PENGELUARAN -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilExpenseTitle"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nama Pengeluaran / Barang"
                app:boxCornerRadiusBottomEnd="@dimen/radius_button"
                app:boxCornerRadiusBottomStart="@dimen/radius_button"
                app:boxCornerRadiusTopEnd="@dimen/radius_button"
                app:boxCornerRadiusTopStart="@dimen/radius_button"
                app:boxStrokeColor="@color/brand_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etExpenseTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:hint="Contoh: Belanja Ayam Fillet 5 Kg"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_base" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- DROPDOWN KATEGORI BIAYA -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilExpenseCategory"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:hint="Kategori Pengeluaran"
                app:boxCornerRadiusBottomEnd="@dimen/radius_button"
                app:boxCornerRadiusBottomStart="@dimen/radius_button"
                app:boxCornerRadiusTopEnd="@dimen/radius_button"
                app:boxCornerRadiusTopStart="@dimen/radius_button"
                app:boxStrokeColor="@color/brand_primary">

                <AutoCompleteTextView
                    android:id="@+id/actvCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:inputType="none"
                    android:text="Bahan Baku"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_base" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- INPUT NOMINAL (RP) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilExpenseAmount"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:hint="Nominal Uang (Rp)"
                app:boxCornerRadiusBottomEnd="@dimen/radius_button"
                app:boxCornerRadiusBottomStart="@dimen/radius_button"
                app:boxCornerRadiusTopEnd="@dimen/radius_button"
                app:boxCornerRadiusTopStart="@dimen/radius_button"
                app:boxStrokeColor="@color/brand_primary"
                app:prefixText="Rp "
                app:prefixTextColor="@color/brand_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etExpenseAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:inputType="number"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_base" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- PILIHAN METODE PEMBAYARAN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:fontFamily="sans-serif-bold"
                android:text="Metode Pembayaran"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs" />

            <RadioGroup
                android:id="@+id/rgPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:orientation="horizontal">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbCash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="Tunai (Cash)"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbTransfer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_24"
                    android:fontFamily="sans-serif-medium"
                    android:text="Transfer Bank"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <!-- SEKSI BUKTI FOTO NOTA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:fontFamily="sans-serif-bold"
                android:text="Bukti Nota Fisik Belanja (Kamera HP)"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCaptureReceipt"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="@dimen/space_8"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="📷 Ambil Foto Nota Langsung"
                android:textColor="@color/brand_primary"
                app:cornerRadius="@dimen/radius_button"
                app:strokeColor="@color/brand_primary" />

            <!-- PREVIEW NOTA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReceiptPreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="@dimen/space_12"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="@dimen/elevation_card"
                app:strokeColor="@color/border_soft"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/ivReceiptPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Preview Nota"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <!-- TOMBOL SIMPAN -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveExpense"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="@dimen/space_32"
                android:backgroundTint="@color/brand_primary"
                android:fontFamily="sans-serif-bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="SIMPAN CATATAN PENGELUARAN"
                android:textColor="@color/text_on_primary"
                android:textSize="@dimen/text_base"
                app:cornerRadius="@dimen/radius_button"
                app:elevation="@dimen/elevation_card" />

            <!-- INDIKATOR LOADING SIMPAN -->
            <ProgressBar
                android:id="@+id/progressBarSave"
                style="?android:attr/progressBarStyle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/space_12"
                android:indeterminateTint="@color/brand_primary"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
