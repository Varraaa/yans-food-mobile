<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutMenuRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <!-- TOP HEADER -->
    <LinearLayout
        android:id="@+id/headerMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingTop="@dimen/space_16"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="KATALOG MENU &amp; STOK"
            android:textColor="@color/brand_primary"
            android:textSize="@dimen/text_lg" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Atur ketersediaan menu gerai secara instan"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_xs" />

        <!-- SEARCH INPUT -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearchMenu"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:hint="Cari nama makanan atau minuman..."
            app:boxCornerRadiusBottomEnd="@dimen/radius_button"
            app:boxCornerRadiusBottomStart="@dimen/radius_button"
            app:boxCornerRadiusTopEnd="@dimen/radius_button"
            app:boxCornerRadiusTopStart="@dimen/radius_button"
            app:boxStrokeColor="@color/brand_primary"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:startIconTint="@color/brand_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearchMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_sm" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- HORIZONTAL FILTER CHIPS -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Semua"
                    app:chipCornerRadius="@dimen/radius_chip" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDimsum"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dimsum"
                    app:chipCornerRadius="@dimen/radius_chip" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipNasi"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Olahan Nasi"
                    app:chipCornerRadius="@dimen/radius_chip" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMinuman"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Minuman"
                    app:chipCornerRadius="@dimen/radius_chip" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDessert"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dessert"
                    app:chipCornerRadius="@dimen/radius_chip" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- LIST MENU RECYCLERVIEW DENGAN SWIPEREFRESH -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshMenu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerMenu">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProducts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:layoutAnimation="@anim/layout_animation_staggered"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingBottom="@dimen/space_24"
                tools:listitem="@layout/item_product" />

            <TextView
                android:id="@+id/tvEmptyMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif"
                android:text="Tidak ada menu yang sesuai dengan filter pencarian."
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_sm"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
